{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OnDevicePiiRules",
  "description": "Configurable on-device PII detection rules for ISRO/SIH privacy perception engine (Zero-Trust)",
  "version": "2.0.0",
  "rules": [
    {
      "id": "aadhaar_india",
      "category": "government_id",
      "label": "Aadhaar Card",
      "description": "Indian 12-digit Unique Identification Number (UIDAI)",
      "patterns": [
        "\\b[2-9]\\d{3}[\\s-]\\d{4}[\\s-]\\d{4}\\b",
        "\\b[2-9]\\d{11}\\b"
      ],
      "domAttributes": ["aadhar", "aadhaar", "uidai", "aadhaar_no", "aadhaarno"],
      "confidence": 0.96,
      "paddingPx": 4
    },
    {
      "id": "pan_india",
      "category": "government_id",
      "label": "PAN Card",
      "description": "Indian Income Tax Permanent Account Number (5 Letters + 4 Digits + 1 Letter)",
      "patterns": [
        "\\b[A-Z]{5}[0-9]{4}[A-Z]{1}\\b"
      ],
      "domAttributes": ["pan", "panno", "pan_card", "pan_number", "incometax_pan"],
      "confidence": 0.98,
      "paddingPx": 4
    },
    {
      "id": "phone_india",
      "category": "contact",
      "label": "Indian Mobile (+91)",
      "description": "Indian standard 10-digit mobile number with optional +91 or 0 prefix",
      "patterns": [
        "(?:\\+91[\\s-]?)?[6-9]\\d{4}[\\s-]?\\d{5}\\b",
        "(?:\\+91[\\s-]?)?[6-9]\\d{9}\\b"
      ],
      "domAttributes": ["phone", "mobile", "contact_no", "mobilenumber", "telephone", "phone_number"],
      "confidence": 0.92,
      "paddingPx": 4
    },
    {
      "id": "payment_card",
      "category": "financial",
      "label": "Payment Card",
      "description": "Visa, MasterCard, RuPay, Amex, Discover credit/debit card numbers with Luhn verification",
      "patterns": [
        "\\b(?:4[0-9]{12}(?:[0-9]{3})?|5[1-5][0-9]{14}|6(?:011|5[0-9]{2})[0-9]{12}|3[47][0-9]{13}|(?:508[5-9]|652[1-2]|606[1-9]|607[0-9]|608[0-5])[0-9]{12})\\b",
        "\\b\\d{4}[\\s-]\\d{4}[\\s-]\\d{4}[\\s-]\\d{4}\\b"
      ],
      "domAttributes": ["card", "cardnumber", "cc-number", "cc-num", "creditcard", "debitcard", "pan_card_payment"],
      "validator": "luhn",
      "confidence": 0.99,
      "paddingPx": 4
    },
    {
      "id": "card_cvv",
      "category": "financial",
      "label": "Card CVV/CVC",
      "description": "3 or 4 digit card security code",
      "patterns": [
        "\\b\\d{3,4}\\b"
      ],
      "domAttributes": ["cvv", "cvc", "cc-csc", "security_code", "card_cvv", "cvv2"],
      "requiresContextOrAttribute": true,
      "confidence": 0.95,
      "paddingPx": 4
    },
    {
      "id": "password_credential",
      "category": "credentials",
      "label": "Password / Token",
      "description": "Input fields and DOM elements containing passwords, PINs, or auth tokens",
      "patterns": [],
      "domAttributes": ["password", "pass", "pwd", "secret", "auth_token", "api_key", "pin", "otp", "passcode"],
      "inputTypes": ["password"],
      "confidence": 1.0,
      "paddingPx": 4
    },
    {
      "id": "email_address",
      "category": "contact",
      "label": "Email Address",
      "description": "Standard RFC 5322 electronic mail address",
      "patterns": [
        "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,7}\\b"
      ],
      "domAttributes": ["email", "e-mail", "user_email", "mail"],
      "inputTypes": ["email"],
      "confidence": 0.97,
      "paddingPx": 4
    }
  ]
}
